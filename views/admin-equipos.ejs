<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Equipos 2v2 — AUA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cinzel+Decorative:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'; this.onload=null;" />
  <link rel="stylesheet" href="/css/admin.css?v=1" />
  <link rel="icon" href="/img/favicon-32x32.png" type="image/png" />
  <style>
    .equipo-card {
      background: var(--bg2);
      border: 0.5px solid var(--brown);
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .equipo-nombre {
      font-family: 'Cinzel', serif;
      font-size: 13px;
      color: var(--gold);
      flex: 1;
    }
    .equipo-jugadores {
      font-size: 12px;
      color: var(--text);
      flex: 2;
    }
    .equipo-elos {
      display: flex;
      gap: 8px;
      font-size: 11px;
      color: var(--dim);
      flex-shrink: 0;
    }
    .elo-chip {
      background: var(--bg3);
      border: 0.5px solid var(--brown);
      border-radius: 5px;
      padding: 3px 8px;
    }
    .elo-promedio {
      color: var(--gold);
      font-weight: 600;
      border-color: rgba(232,200,122,0.3);
    }
    .cap-ok  { color: var(--win); }
    .cap-err { color: #cc5555; }
    .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .elo-preview {
      margin-top: 10px;
      padding: 10px 14px;
      background: var(--bg3);
      border: 0.5px solid var(--brown);
      border-radius: 7px;
      font-size: 12px;
      color: var(--dim);
      display: none;
    }
    .elo-preview.visible { display: block; }
    .btn-delete {
      padding: 5px 10px;
      font-size: 11px;
      background: rgba(200,60,60,0.1);
      border: 0.5px solid rgba(200,60,60,0.35);
      color: #cc5555;
      border-radius: 5px;
      cursor: pointer;
      flex-shrink: 0;
    }
    .btn-delete:hover { background: rgba(200,60,60,0.2); }
    .torneo-header {
      font-family: 'Cinzel', serif;
      font-size: 13px;
      color: var(--gold);
      border-bottom: 0.5px solid var(--brown);
      padding-bottom: 8px;
      margin: 24px 0 14px;
      letter-spacing: .05em;
    }
    .empty-equipo {
      font-size: 12px;
      color: var(--dim);
      padding: 12px 0;
    }
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">⚔</div>
      <div class="brand-text">Centro de<br>Mando</div>
    </div>
    <div class="sidebar-nav">
      <div class="nav-label">Admin</div>
      <a href="/admin" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L2 3v5c0 3.5 2.5 6.5 6 7.5C14 14.5 14 11 14 8V3L8 1z"/></svg>
        Panel General
      </a>
      <a href="/admin/equipos" class="nav-item active">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M5 3a3 3 0 106 0A3 3 0 005 3zm-3 9c0-2.2 2.7-4 6-4s6 1.8 6 4v1H2v-1z"/></svg>
        Equipos 2v2
      </a>
      <a href="/admin/partidos" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3 1h10v4c0 2.76-2.24 5-5 5S3 7.76 3 5V1zm-2 1v3a3 3 0 003 3v1H3v1h10v-1H9V8a3 3 0 003-3V2H5zm6 9H7v1H5v1h6v-1H9v-1z"/></svg>
        Control de Partidos
      </a>
      <a href="/admin/resultados" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2h12v12H2V2zm1 1v10h10V3H3zm2 2h6v1H5V5zm0 2h6v1H5V7zm0 2h4v1H5V9z"/></svg>
        Resultados
      </a>
      <a href="/admin/penca" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2 5h5l-4 3 2 5-5-3-5 3 2-5-4-3h5z"/></svg>
        Control Penca
      </a>
      <div class="nav-label" style="margin-top:8px">Navegación</div>
      <a href="/dashboard" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L1 7h2v7h4v-4h2v4h4V7h2L8 1z"/></svg>
        Mi Dashboard
      </a>
    </div>
    <div class="sidebar-user">
      <img src="<%= user.image %>" alt="Avatar" class="user-avatar" />
      <span class="user-name"><%= user.name %></span>
      <a href="/auth/logout" style="color:#884444" title="Cerrar sesión">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M6 2H2v12h4v-1H3V3h3V2zm5 3l-1 1 2 2H5v1h7l-2 2 1 1 4-4-4-3z"/></svg>
      </a>
    </div>
  </aside>

  <main class="main">
    <div class="page-title">Equipos 2v2</div>

    <% if (flash) { %><div class="alert alert-ok"><%= flash %></div><% } %>
    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>

    <!-- Formulario crear equipo -->
    <div class="panel" style="margin-bottom:28px">
      <div class="panel-header">
        <span class="panel-title">Registrar nuevo equipo</span>
        <span class="panel-count">Tope: ELO promedio ≤ 1700</span>
      </div>
      <div style="padding:20px">
        <form method="POST" action="/admin/equipos/crear" id="form-equipo">
          <div style="margin-bottom:14px">
            <label style="font-size:11px;color:var(--dim);display:block;margin-bottom:6px">Torneo</label>
            <select name="torneo_id" required style="width:100%;padding:9px 12px;background:var(--bg3);border:0.5px solid var(--brown);border-radius:7px;color:var(--text);font-size:12px;outline:none">
              <option value="">Seleccionar torneo...</option>
              <% torneos.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.nombre %></option>
              <% }) %>
            </select>
          </div>

          <div style="margin-bottom:14px">
            <label style="font-size:11px;color:var(--dim);display:block;margin-bottom:6px">Nombre del equipo</label>
            <input type="text" name="nombre" placeholder="Ej: Los Conquistadores" required
              style="width:100%;padding:9px 12px;background:var(--bg3);border:0.5px solid var(--brown);border-radius:7px;color:var(--text);font-size:12px;outline:none;box-sizing:border-box" />
          </div>

          <div class="form-row-2" style="margin-bottom:10px">
            <div>
              <label style="font-size:11px;color:var(--dim);display:block;margin-bottom:6px">Jugador 1</label>
              <select name="jugador1_id" id="j1" required onchange="calcularElo()"
                style="width:100%;padding:9px 12px;background:var(--bg3);border:0.5px solid var(--brown);border-radius:7px;color:var(--text);font-size:12px;outline:none">
                <option value="">Seleccionar...</option>
                <% usuarios.forEach(u => { %>
                <option value="<%= u.discordId %>" data-elo="<%= u.elo %>"><%= u.nombre %> (<%= u.elo %>)</option>
                <% }) %>
              </select>
            </div>
            <div>
              <label style="font-size:11px;color:var(--dim);display:block;margin-bottom:6px">Jugador 2</label>
              <select name="jugador2_id" id="j2" required onchange="calcularElo()"
                style="width:100%;padding:9px 12px;background:var(--bg3);border:0.5px solid var(--brown);border-radius:7px;color:var(--text);font-size:12px;outline:none">
                <option value="">Seleccionar...</option>
                <% usuarios.forEach(u => { %>
                <option value="<%= u.discordId %>" data-elo="<%= u.elo %>"><%= u.nombre %> (<%= u.elo %>)</option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="elo-preview" id="elo-preview"></div>

          <button type="submit" class="btn-save" style="margin-top:14px;width:100%">
            <i class="fas fa-users" style="margin-right:7px"></i>Crear equipo
          </button>
        </form>
      </div>
    </div>

    <!-- Equipos registrados por torneo -->
    <% equiposPorTorneo.forEach(torneo => { %>
    <div class="torneo-header">
      <%= torneo.nombre %>
      <span style="font-size:11px;color:var(--dim);font-family:'Inter'">(<%= torneo.equipos.length %> equipo<%= torneo.equipos.length !== 1 ? 's' : '' %>)</span>
    </div>

    <% if (torneo.equipos.length === 0) { %>
    <div class="empty-equipo">Sin equipos registrados aún.</div>
    <% } else { %>
    <% torneo.equipos.forEach(eq => { %>
    <div class="equipo-card">
      <div class="equipo-nombre"><%= eq.nombre %></div>
      <div class="equipo-jugadores">
        <i class="fas fa-user" style="margin-right:5px;color:var(--dim)"></i><%= eq.nombre1 %>
        <span style="color:var(--dim);margin:0 8px">+</span>
        <i class="fas fa-user" style="margin-right:5px;color:var(--dim)"></i><%= eq.nombre2 %>
      </div>
      <div class="equipo-elos">
        <span class="elo-chip"><%= eq.elo1 %></span>
        <span class="elo-chip"><%= eq.elo2 %></span>
        <span class="elo-chip elo-promedio">Ø <%= eq.elo_promedio %></span>
      </div>
      <form method="POST" action="/admin/equipos/eliminar" style="margin:0">
        <input type="hidden" name="equipo_id" value="<%= eq.id %>" />
        <button type="submit" class="btn-delete" onclick="return confirm('¿Eliminar equipo <%= eq.nombre %>?')">
          <i class="fas fa-trash"></i>
        </button>
      </form>
    </div>
    <% }) %>
    <% } %>
    <% }) %>

    <% if (torneos.length === 0) { %>
    <div class="empty-msg">No hay torneos activos. Creá uno primero desde el Panel General.</div>
    <% } %>

  </main>
</div>

<script>
function redondear50(elo) {
  return Math.round(elo / 50) * 50;
}

function calcularElo() {
  const j1 = document.getElementById('j1');
  const j2 = document.getElementById('j2');
  const preview = document.getElementById('elo-preview');

  const elo1raw = parseInt(j1.selectedOptions[0]?.dataset?.elo);
  const elo2raw = parseInt(j2.selectedOptions[0]?.dataset?.elo);

  if (!elo1raw || !elo2raw) { preview.classList.remove('visible'); return; }

  const elo1 = redondear50(elo1raw);
  const elo2 = redondear50(elo2raw);
  const promedio = Math.round((elo1 + elo2) / 2);
  const ok = promedio <= 1700;

  preview.classList.add('visible');
  preview.innerHTML = `
    <span style="color:var(--text)">${j1.selectedOptions[0].text.split(' (')[0]}</span>
    <span style="color:var(--dim)"> → ELO redondeado: </span>
    <strong style="color:var(--gold)">${elo1}</strong>
    <span style="color:var(--dim);margin:0 10px">|</span>
    <span style="color:var(--text)">${j2.selectedOptions[0].text.split(' (')[0]}</span>
    <span style="color:var(--dim)"> → ELO redondeado: </span>
    <strong style="color:var(--gold)">${elo2}</strong>
    <br><br>
    <span style="color:var(--dim)">ELO promedio del equipo: </span>
    <strong class="${ok ? 'cap-ok' : 'cap-err'}" style="font-size:14px">${promedio}</strong>
    ${ok
      ? '<span style="color:var(--win);margin-left:8px"><i class="fas fa-check"></i> Dentro del tope (≤ 1700)</span>'
      : '<span style="color:#cc5555;margin-left:8px"><i class="fas fa-times"></i> Supera el tope de 1700</span>'
    }
  `;

  document.querySelector('button[type="submit"]').disabled = !ok;
}
</script>
</body>
</html>
