<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Resultados — AUA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cinzel+Decorative:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'; this.onload=null;" />
  <link rel="stylesheet" href="/css/admin.css?v=1" />
  <link rel="icon" href="/img/favicon-32x32.png" type="image/png" />
  <style>
    .resultado-card {
      background: var(--bg2);
      border: 0.5px solid var(--brown);
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .resultado-display {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
    }
    .res-players {
      flex: 1;
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
    }
    .res-score {
      font-family: 'Cinzel', serif;
      font-size: 20px;
      font-weight: 700;
      color: var(--gold);
      min-width: 60px;
      text-align: center;
    }
    .res-meta {
      font-size: 10px;
      color: var(--dim);
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .btn-edit-toggle {
      padding: 5px 12px;
      font-size: 11px;
      background: rgba(232,200,122,0.08);
      border: 0.5px solid rgba(232,200,122,0.3);
      color: var(--gold);
      border-radius: 6px;
      cursor: pointer;
      white-space: nowrap;
    }
    .btn-edit-toggle:hover { background: rgba(232,200,122,0.15); }
    .edit-form {
      display: none;
      padding: 12px 16px;
      background: var(--bg3);
      border-top: 0.5px solid var(--brown);
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }
    .edit-form.open { display: flex; }
    .edit-score-input {
      width: 52px;
      padding: 8px 6px;
      background: var(--bg2);
      border: 0.5px solid var(--brown);
      border-radius: 7px;
      color: var(--text);
      font-size: 15px;
      font-weight: 600;
      text-align: center;
      outline: none;
    }
    .edit-score-input:focus { border-color: var(--gold2); }
    .edit-sep { font-family: 'Cinzel', serif; color: var(--dim); font-size: 14px; }
    .check-label { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); cursor: pointer; }
    .btn-save-edit {
      padding: 7px 16px;
      font-size: 12px;
      font-weight: 600;
      background: var(--gold);
      color: var(--bg0);
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    .btn-save-edit:hover { background: var(--gold-light); }
    .btn-cancel {
      padding: 7px 12px;
      font-size: 12px;
      background: transparent;
      border: 0.5px solid var(--brown);
      color: var(--dim);
      border-radius: 6px;
      cursor: pointer;
    }
    .penca-badge {
      font-size: 9px;
      padding: 2px 7px;
      border-radius: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .penca-si { background: rgba(168,200,96,0.1); color: var(--win); border: 0.5px solid rgba(168,200,96,0.3); }
    .penca-no { background: rgba(255,255,255,0.04); color: var(--dim); border: 0.5px solid var(--brown); }
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">⚔</div>
      <div class="brand-text">Centro de<br>Mando</div>
    </div>
    <div class="sidebar-nav">
      <div class="nav-label">Admin</div>
      <a href="/admin" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L2 3v5c0 3.5 2.5 6.5 6 7.5C14 14.5 14 11 14 8V3L8 1z"/></svg>
        Panel General
      </a>
      <a href="/admin/partidos" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3 1h10v4c0 2.76-2.24 5-5 5S3 7.76 3 5V1zm-2 1v3a3 3 0 003 3v1H3v1h10v-1H9V8a3 3 0 003-3V2H5zm6 9H7v1H5v1h6v-1H9v-1z"/></svg>
        Control de Partidos
      </a>
      <a href="/admin/resultados" class="nav-item active">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2h12v12H2V2zm1 1v10h10V3H3zm2 2h6v1H5V5zm0 2h6v1H5V7zm0 2h4v1H5V9z"/></svg>
        Resultados
      </a>
      <a href="/admin/penca" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2 5h5l-4 3 2 5-5-3-5 3 2-5-4-3h5z"/></svg>
        Control Penca
      </a>
      <div class="nav-label" style="margin-top:8px">Navegación</div>
      <a href="/dashboard" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L1 7h2v7h4v-4h2v4h4V7h2L8 1z"/></svg>
        Mi Dashboard
      </a>
    </div>
    <div class="sidebar-user">
      <img src="<%= user.image %>" alt="Avatar" class="user-avatar" />
      <span class="user-name"><%= user.name %></span>
      <a href="/auth/logout" style="color:#884444" title="Cerrar sesión">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M6 2H2v12h4v-1H3V3h3V2zm5 3l-1 1 2 2H5v1h7l-2 2 1 1 4-4-4-3z"/></svg>
      </a>
    </div>
  </aside>

  <main class="main">
    <div class="page-title">Resultados cargados</div>

    <% if (flash) { %><div class="alert alert-ok"><%= flash %></div><% } %>
    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>

    <% if (!torneosConResultados || torneosConResultados.length === 0) { %>
    <div class="empty-msg">No hay resultados cargados todavía.</div>
    <% } else { %>

    <% torneosConResultados.forEach(torneo => { %>
    <div style="margin-bottom:32px">
      <div style="font-family:'Cinzel',serif;font-size:14px;color:var(--gold);border-bottom:0.5px solid var(--brown);padding-bottom:8px;margin-bottom:16px;letter-spacing:.05em">
        <%= torneo.nombre %> <span style="font-size:11px;color:var(--dim);font-family:'Inter'">(<%= torneo.partidos.length %> resultado<%= torneo.partidos.length !== 1 ? 's' : '' %>)</span>
      </div>

      <% torneo.partidos.forEach(p => { %>
      <div class="resultado-card">
        <div class="resultado-display">
          <div class="res-players">
            <%= p.eq1 || p.j1 %>
            <span style="color:var(--dim);font-weight:400;margin:0 6px">vs</span>
            <%= p.eq2 || p.j2 %>
          </div>
          <div style="display:flex;align-items:center;gap:10px">
            <span class="res-score"><%= p.score1 %> – <%= p.score2 %></span>
            <span class="penca-badge <%= p.cuenta_penca ? 'penca-si' : 'penca-no' %>">
              <%= p.cuenta_penca ? 'Penca ✓' : 'Sin penca' %>
            </span>
            <span class="res-meta"><%= p.fase %> · R<%= p.ronda %></span>
          </div>
          <button class="btn-edit-toggle" onclick="toggleEdit('<%= p.id %>')">
            <i class="fas fa-pen" style="margin-right:5px"></i>Editar
          </button>
        </div>

        <form id="edit-<%= p.id %>" class="edit-form" method="POST" action="/api/partidos/editar-resultado">
          <input type="hidden" name="partidoId" value="<%= p.id %>" />
          <div style="font-size:12px;color:var(--muted);flex-shrink:0"><%= p.j1 %></div>
          <input type="number" class="edit-score-input" name="score1" value="<%= p.score1 %>" min="0" max="9" />
          <span class="edit-sep">–</span>
          <input type="number" class="edit-score-input" name="score2" value="<%= p.score2 %>" min="0" max="9" />
          <div style="font-size:12px;color:var(--muted);flex-shrink:0"><%= p.j2 %></div>
          <label class="check-label">
            <input type="checkbox" name="cuenta_penca" value="1" <%= p.cuenta_penca ? 'checked' : '' %> />
            Cuenta en penca
          </label>
          <button type="submit" class="btn-save-edit">
            <i class="fas fa-save" style="margin-right:5px"></i>Guardar
          </button>
          <button type="button" class="btn-cancel" onclick="toggleEdit('<%= p.id %>')">Cancelar</button>
        </form>
      </div>
      <% }) %>
    </div>
    <% }) %>

    <% } %>
  </main>
</div>

<script>
function toggleEdit(id) {
  const form = document.getElementById('edit-' + id);
  form.classList.toggle('open');
}
</script>
</body>
</html>
