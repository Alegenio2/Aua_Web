<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Centro de Mando — AUA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cinzel+Decorative:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="icon" href="/img/favicon-32x32.png" type="image/png" />
</head>
<body>
<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">⚔</div>
      <div class="brand-text">Centro de<br>Mando</div>
    </div>
    <div class="sidebar-nav">
      <div class="nav-label">Admin</div>
      <a href="/admin" class="nav-item active">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L2 3v5c0 3.5 2.5 6.5 6 7.5C14 14.5 14 11 14 8V3L8 1z"/></svg>
        Panel General
      </a>
      <a href="/admin#inscriptos" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M5 7a3 3 0 110-6 3 3 0 010 6zm0 1c-2.67 0-5 1.34-5 3v1h10v-1c0-1.66-2.33-3-5-3zm8-1a2 2 0 110-4 2 2 0 010 4zm2 5h-4v-1c0-.88-.47-1.67-1.18-2.18C11.06 9.28 11.5 9 12 9c2 0 3 1 3 2v1z"/></svg>
        Inscriptos
        <% const totalInscriptos = Object.values(inscriptosPorTorneo).reduce((sum, arr) => sum + arr.length, 0); %>
        <% if (totalInscriptos > 0) { %><span class="nav-badge"><%= totalInscriptos %></span><% } %>
      </a>
      <a href="/admin#crear" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Crear Torneo
      </a>
      <a href="/admin#gestion" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 5a3 3 0 100 6A3 3 0 008 5z"/></svg>
        Gestión
        <% if (torneos.length > 0) { %><span class="nav-badge"><%= torneos.length %></span><% } %>
      </a>
      <a href="/admin/usuarios" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M5 7a3 3 0 110-6 3 3 0 010 6zm0 1c-2.67 0-5 1.34-5 3v1h10v-1c0-1.66-2.33-3-5-3zm8-1a2 2 0 110-4 2 2 0 010 4zm2 5h-4v-1c0-.88-.47-1.67-1.18-2.18C11.06 9.28 11.5 9 12 9c2 0 3 1 3 2v1z"/></svg>
        Jugadores
      </a>
      <a href="/admin/partidos" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2l4 4-1 1 2 2 1-1 4 4 1-1-4-4 1-1-2-2-1 1L4 1 2 2zm9 9l-1 1 2 2 2-1-1-2-2 0zM5 10l-3 3 1 2 2-1 1-3-1-1z"/></svg>
        Control Partidos
      </a>
      <a href="/admin/penca" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3 1h10v4c0 2.76-2.24 5-5 5S3 7.76 3 5V1zm-2 1v3a3 3 0 003 3v1H3v1h10v-1H9V8a3 3 0 003-3V2H5zm6 9H7v1H5v1h6v-1H9v-1z"/></svg>
        Control Penca
      </a>
      <div class="nav-label" style="margin-top:8px">Navegación</div>
      <a href="/dashboard" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L1 7h2v7h4v-4h2v4h4V7h2L8 1z"/></svg>
        Mi Dashboard
      </a>
    </div>
    <div class="sidebar-user">
      <img src="<%= user.image %>" alt="Avatar" class="user-avatar" />
      <span class="user-name"><%= user.name %></span>
      <a href="/auth/logout" class="signout-link" title="Cerrar sesión">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M6 2H2v12h4v-1H3V3h3V2zm5 3l-1 1 2 2H5v1h7l-2 2 1 1 4-4-4-3z"/></svg>
      </a>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <div class="page-header">
      <div>
        <div class="page-title">Centro de Mando</div>
        <div class="page-sub">
          <% if (torneoActivo) { %>Torneo activo: <%= torneoActivo.nombre %><% } else { %>Sin torneo activo actualmente<% } %>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:10px">
        <a href="/admin/penca" class="btn-action" style="padding:10px 16px;white-space:nowrap">Control Penca</a>
        <div class="admin-badge">Administrador</div>
      </div>
    </div>

    <% if (flash) { %><div class="alert alert-ok"><%= flash %></div><% } %>
    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>

    <div class="content-grid">

      <!-- COLUMNA IZQUIERDA -->
      <div>

        <!-- GENERAR TORNEO — itera sobre todos los torneos en curso -->
        <% if (torneosJugandoData.length > 0) { %>
        <div id="generar" style="margin-bottom:24px">
          <div class="section-label">Generación de torneos</div>
          <% torneosJugandoData.forEach(tj => {
               const fmtLabel = tj.formato === 'liga' ? 'Liga'
                 : tj.formato === 'eliminacion_directa' ? 'Elim. directa'
                 : tj.formato === 'grupos_eliminatoria' ? 'Grupos + Elim.'
                 : tj.formato === 'doble_eliminacion'   ? 'Doble Elim.'
                 : 'Desconocido';
          %>
          <div class="panel" style="margin-bottom:14px;border-color:<%= tj.partidosGenerados === 0 ? 'rgba(232,200,122,0.4)' : 'var(--brown)' %>">
            <div class="panel-header">
              <span class="panel-title"><%= tj.nombre %></span>
              <span class="estado-badge <%= tj.partidosGenerados > 0 ? 'estado-jugando' : 'estado-inscripcion' %>">
                <%= tj.partidosGenerados > 0 ? 'GENERADO' : 'PENDIENTE' %>
              </span>
            </div>
            <div style="padding:20px">
              <div class="gen-stats">
                <div class="gen-stat">
                  <div class="gen-stat-label">Formato</div>
                  <div class="gen-stat-value" style="font-size:13px"><%= fmtLabel %></div>
                </div>
                <div class="gen-stat">
                  <div class="gen-stat-label">Inscriptos</div>
                  <div class="gen-stat-value"><%= tj.inscriptosJugando %></div>
                </div>
                <div class="gen-stat">
                  <div class="gen-stat-label"><%= tj.partidosGenerados > 0 ? 'Partidos' : 'Grupos' %></div>
                  <div class="gen-stat-value"><%= tj.partidosGenerados > 0 ? tj.partidosGenerados : (tj.cantidad_grupos || '—') %></div>
                </div>
              </div>

              <% if (tj.partidosGenerados > 0) { %>
              <div class="gen-ok">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 8l4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                Torneo generado — <% if (tj.gruposGenerados > 0) { %><%= tj.gruposGenerados %> grupos y <% } %><%= tj.partidosGenerados %> partidos creados.
                <a href="/admin/partidos" style="margin-left:auto;font-size:11px;color:var(--gold);border:0.5px solid rgba(232,200,122,0.3);padding:4px 10px;border-radius:5px">Ver partidos</a>
              </div>
              <% if (tj.formato === 'grupos_eliminatoria' && tj.playoffsGenerados === 0) { %>
              <form method="POST" action="/api/torneos/generar-playoffs" style="margin-top:12px">
                <input type="hidden" name="torneoId" value="<%= tj.id %>" />
                <button type="submit" class="btn-generar" style="background:linear-gradient(135deg,#3a5820,#2a4010)">
                  Generar Playoffs desde Grupos
                </button>
              </form>
              <% } else if (tj.formato === 'grupos_eliminatoria' && tj.playoffsGenerados > 0) { %>
              <div class="gen-ok" style="margin-top:8px;border-color:#3a5820">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 8l4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                Playoffs generados — <%= tj.playoffsGenerados %> partidos de eliminatoria.
              </div>
              <% } %>
              <% } else { %>
              <div class="gen-info">
                <% if (tj.formato === 'eliminacion_directa') { %>
                  Se creará un bracket de eliminación directa con <%= tj.inscriptosJugando %> participantes ordenados por ELO.
                <% } else { %>
                  Se dividirán <%= tj.inscriptosJugando %> jugadores en <%= tj.cantidad_grupos %> grupos usando Snake Draft (por ELO). Cada grupo jugará todos contra todos.
                <% } %>
              </div>
              <form method="POST" action="/api/torneos/generar">
                <input type="hidden" name="torneoId" value="<%= tj.id %>" />
                <button type="submit" class="btn-generar" <%= tj.inscriptosJugando < 2 ? 'disabled' : '' %>>
                  <%= tj.inscriptosJugando < 2 ? 'Faltan inscriptos' : 'Generar torneo' %>
                </button>
              </form>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>

        <!-- ESTADO DEL TORNEO — itera sobre todos los torneos en curso -->
        <% torneosJugandoData.forEach(tj => {
             const ep = tj.estadoPartidos;
             const totalPendientes = ep.sinCoordar.length + ep.sinReportar.length + ep.pendientes.length;
             if (totalPendientes === 0) return;
        %>
        <div id="estado-<%= tj.id %>" style="margin-bottom:24px">
          <div class="section-label">Estado — <%= tj.nombre %></div>

          <% if (ep.sinReportar.length > 0) { %>
          <div class="panel" style="margin-bottom:14px;border-color:#7a3020">
            <div class="panel-header">
              <span class="panel-title" style="color:#c87060">Sin reportar (<%= ep.sinReportar.length %>)</span>
              <span style="font-size:11px;color:var(--dim)">Fecha pasada — esperando resultado</span>
            </div>
            <% ep.sinReportar.forEach(p => { %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 16px;border-bottom:0.5px solid rgba(58,42,26,0.3)">
              <div>
                <a href="/jugador/<%= p.j1_id %>" style="color:var(--text);text-decoration:none"><%= p.j1 %></a>
                <span style="color:var(--dim);margin:0 6px">vs</span>
                <a href="/jugador/<%= p.j2_id %>" style="color:var(--text);text-decoration:none"><%= p.j2 %></a>
                <span style="font-size:11px;color:var(--dim);margin-left:8px"><%= p.fase %> R<%= p.ronda %></span>
              </div>
              <div style="font-size:11px;color:#c87060"><%= new Date(p.coordinado).toLocaleString('es-UY') %></div>
            </div>
            <% }) %>
          </div>
          <% } %>

          <% if (ep.sinCoordar.length > 0) { %>
          <div class="panel" style="margin-bottom:14px;border-color:#6a5010">
            <div class="panel-header">
              <span class="panel-title" style="color:var(--gold)">Sin coordinar (<%= ep.sinCoordar.length %>)</span>
              <span style="font-size:11px;color:var(--dim)">Aún no acordaron fecha</span>
            </div>
            <% ep.sinCoordar.forEach(p => { %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 16px;border-bottom:0.5px solid rgba(58,42,26,0.3)">
              <div>
                <a href="/jugador/<%= p.j1_id %>" style="color:var(--text);text-decoration:none"><%= p.j1 %></a>
                <span style="color:var(--dim);margin:0 6px">vs</span>
                <a href="/jugador/<%= p.j2_id %>" style="color:var(--text);text-decoration:none"><%= p.j2 %></a>
                <span style="font-size:11px;color:var(--dim);margin-left:8px"><%= p.fase %> R<%= p.ronda %></span>
              </div>
              <div style="font-size:11px;color:var(--dim)">Sin fecha</div>
            </div>
            <% }) %>
          </div>
          <% } %>

          <% if (ep.pendientes.length > 0) { %>
          <div class="panel" style="margin-bottom:14px">
            <div class="panel-header">
              <span class="panel-title">Coordinados (<%= ep.pendientes.length %>)</span>
              <span style="font-size:11px;color:var(--win)">Fecha futura acordada</span>
            </div>
            <% ep.pendientes.forEach(p => { %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 16px;border-bottom:0.5px solid rgba(58,42,26,0.3)">
              <div>
                <a href="/jugador/<%= p.j1_id %>" style="color:var(--text);text-decoration:none"><%= p.j1 %></a>
                <span style="color:var(--dim);margin:0 6px">vs</span>
                <a href="/jugador/<%= p.j2_id %>" style="color:var(--text);text-decoration:none"><%= p.j2 %></a>
                <span style="font-size:11px;color:var(--dim);margin-left:8px"><%= p.fase %> R<%= p.ronda %></span>
              </div>
              <div style="font-size:11px;color:var(--win)"><%= new Date(p.coordinado).toLocaleString('es-UY') %></div>
            </div>
            <% }) %>
          </div>
          <% } %>

        </div>
        <% }) %>

        <!-- INSCRIPTOS -->
        <% if (torneosConInscriptos.length > 0) { %>
        <div id="inscriptos">
          <div class="section-label">Inscriptos en Torneos</div>
          <% torneosConInscriptos.forEach(torneo => { %>
          <div class="panel" style="margin-bottom:24px">
            <div class="panel-header">
              <span class="panel-title"><%= torneo.nombre %></span>
              <span class="panel-count"><%= inscriptosPorTorneo[torneo.id].length %> inscriptos</span>
            </div>
            <% if (inscriptosPorTorneo[torneo.id].length === 0) { %>
            <div class="empty-msg">Esperando guerreros...</div>
            <% } else { %>
            <table>
              <thead>
                <tr>
                  <th>Jugador</th><th>Clan</th><th>País</th><th>ELO</th>
                  <% if (torneo.tipo !== '1v1') { %><th>Equipo</th><% } %>
                  <% if (torneo.estado === 'inscripcion') { %><th></th><% } %>
                </tr>
              </thead>
              <tbody>
                <% inscriptosPorTorneo[torneo.id].forEach(j => { %>
                <tr>
                  <td><%= j.nombre %></td>
                  <td style="color:var(--muted)"><%= j.clan || '—' %></td>
                  <td style="color:var(--muted)"><%= j.pais %></td>
                  <td class="gold"><%= j.elo_inscripcion %></td>
                  <% if (torneo.tipo !== '1v1') { %><td style="font-family:monospace;font-size:11px;color:var(--dim)"><%= j.equipo_id %></td><% } %>
                  <% if (torneo.estado === 'inscripcion') { %>
                  <td>
                    <div style="display:flex;gap:4px;justify-content:flex-end">
                      <button class="btn-action" style="padding:3px 8px;font-size:11px" onclick="abrirEditarElo('<%= torneo.id %>', '<%= j.usuario_id %>', '<%= j.nombre %>', <%= j.elo_inscripcion %>)">✎</button>
                      <form method="POST" action="/api/torneos/desinscribir" style="margin:0;display:inline">
                        <input type="hidden" name="torneoId" value="<%= torneo.id %>" />
                        <input type="hidden" name="userId" value="<%= j.usuario_id %>" />
                        <button type="submit" class="btn-action btn-danger" style="padding:3px 8px;font-size:11px" onclick="return confirm('¿Remover a <%= j.nombre %> del torneo?')">×</button>
                      </form>
                    </div>
                  </td>
                  <% } %>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% } %>

        <!-- GESTIÓN -->
        <div id="gestion">
          <div class="section-label">Gestión de Torneos</div>
          <div class="panel">
            <div class="panel-header">
              <span class="panel-title">Todos los torneos</span>
              <span class="panel-count"><%= torneos.length %> torneos</span>
            </div>
            <% if (torneos.length === 0) { %>
            <div class="empty-msg">No hay torneos creados aún.</div>
            <% } else { %>
            <% torneos.forEach(t => { %>
            <div class="torneo-row">
              <div style="flex:1;min-width:0">
                <div class="torneo-nombre"><%= t.nombre %></div>
                <div style="display:flex;gap:8px;align-items:center">
                  <span class="estado-badge estado-<%= t.estado === 'inscripcion' ? 'inscripcion' : t.estado === 'jugando' ? 'jugando' : 'otro' %>">
                    <%= t.estado.toUpperCase() %>
                  </span>
                  <span style="font-size:10px;color:var(--dim)"><%= t.tipo %></span>
                </div>
              </div>
              <div style="display:flex;gap:8px;flex-shrink:0">
                <% if (t.estado === 'inscripcion') { %>
                <form method="POST" action="/api/torneos/estado">
                  <input type="hidden" name="id" value="<%= t.id %>" />
                  <input type="hidden" name="nuevoEstado" value="jugando" />
                  <button type="submit" class="btn-action">Cerrar inscripciones</button>
                </form>
                <% } %>
                <% if (t.estado === 'jugando') { %>
                <form method="POST" action="/api/torneos/estado">
                  <input type="hidden" name="id" value="<%= t.id %>" />
                  <input type="hidden" name="nuevoEstado" value="finalizado" />
                  <button type="submit" class="btn-action btn-danger">Finalizar torneo</button>
                </form>
                <% } %>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>
        </div>

      </div><!-- /col izquierda -->

      <!-- COLUMNA DERECHA: CREAR TORNEO -->
      <div id="crear">
        <div class="section-label">Crear nuevo torneo</div>
        <div class="panel">
          <div class="panel-header">
            <span class="panel-title">Fundar torneo</span>
          </div>
          <form method="POST" action="/api/torneos/crear" class="form-grid">

            <div>
              <label>Nombre del torneo</label>
              <input type="text" name="nombre" placeholder="Ej: Liga Premier AUA" required />
            </div>

            <div class="form-row">
              <div>
                <label>Tipo</label>
                <select name="tipo">
                  <option value="1v1">1v1 — Individual</option>
                  <option value="2v2">2v2 — Equipos</option>
                  <option value="3v3">3v3 — Equipos</option>
                  <option value="4v4">4v4 — Equipos</option>
                </select>
              </div>
              <div>
                <label>Formato</label>
                <select name="formato" id="formatoSelect">
                  <option value="liga">Liga (Round Robin)</option>
                  <option value="grupos_eliminatoria">Grupos + Eliminatorias</option>
                  <option value="eliminacion_directa">Eliminación Directa</option>
                  <option value="doble_eliminacion">Doble Eliminación</option>
                </select>
              </div>
            </div>

            <div class="elo-box">
              <div class="form-row" style="margin-bottom:10px">
                <div>
                  <label>ELO Mínimo</label>
                  <input type="number" name="elo_min" value="0" />
                </div>
                <div>
                  <label>ELO Máximo</label>
                  <input type="number" name="elo_max" value="3000" />
                </div>
              </div>
              <div>
                <label>Handicap (Redondeo)</label>
                <select name="valor_handicap">
                  <option value="0">Desactivado</option>
                  <option value="50">Redondear cada 50 pts</option>
                  <option value="75">Redondear cada 75 pts</option>
                  <option value="100">Redondear cada 100 pts</option>
                </select>
              </div>
            </div>

            <div class="form-row" id="gruposConfig">
              <div>
                <label>Cant. grupos</label>
                <input type="number" name="cantidad_grupos" value="4" />
              </div>
              <div>
                <label>Clasif./grupo</label>
                <input type="number" name="clasificados_por_grupo" value="2" />
              </div>
            </div>

            <button type="submit" class="btn-submit">Fundar torneo</button>
          </form>
        </div>
      </div>

    </div><!-- /content-grid -->
  </main>
</div>

<script>
  function toggleGrupos() {
    const fmt = document.getElementById('formatoSelect').value;
    document.getElementById('gruposConfig').style.display = fmt === 'liga' ? 'none' : 'grid';
  }
  document.getElementById('formatoSelect').addEventListener('change', toggleGrupos);
  toggleGrupos();

  function abrirEditarElo(torneoId, userId, nombre, eloActual) {
    const nuevoElo = prompt(`Editar ELO de ${nombre}\n\nELO actual: ${eloActual}\n\nIngresa el nuevo ELO:`, eloActual);
    
    if (nuevoElo !== null) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/editar-elo';
      
      const campos = [
        { name: 'torneoId', value: torneoId },
        { name: 'userId', value: userId },
        { name: 'nuevoElo', value: nuevoElo }
      ];
      
      campos.forEach(campo => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = campo.name;
        input.value = campo.value;
        form.appendChild(input);
      });
      
      document.body.appendChild(form);
      form.submit();
    }
  }
</script>
</body>
</html>
