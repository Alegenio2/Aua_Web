<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — AUA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="preload" as="style" href="/css/admin.css?v=1">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cinzel+Decorative:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css?v=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" media="print" onload="this.media='all'; this.onload=null;" />
  <link rel="icon" href="/img/favicon-32x32.png" type="image/png" />
</head>
<body>
<div class="app">

  <!-- Hamburger Menu Button (Mobile Only) -->
  <button class="sidebar-hamburger" id="sidebar-hamburger" aria-label="Toggle sidebar">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <!-- ── SIDEBAR ── -->
  <aside class="sidebar" id="dashboard-sidebar">

    <!-- Usuario -->
    <div class="sidebar-user-top">
      <div class="avatar-row">
        <% if (user.image) { %>
          <img src="<%= user.image %>" alt="Avatar" class="avatar-lg" />
        <% } %>
        <div style="min-width:0;flex:1">
          <div class="user-name-lg"><%= user.name %></div>
          <% if (usuarioInterno) { %>
          <div class="badge-row">
            <span class="elo-pill">ELO <%= usuarioInterno.elo %></span>
            <% if (usuarioInterno.clan) { %><span class="clan-pill"><%= usuarioInterno.clan %></span><% } %>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Nav -->
    <div class="sidebar-nav">
      <div class="nav-label">Principal</div>
      <a href="/dashboard" class="nav-item active">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1L1 7h2v7h4v-4h2v4h4V7h2L8 1z"/></svg>
        Mi Dashboard
      </a>
      <% if (isAdmin) { %>
      <a href="/admin" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3 2h10v4H3V2zm0 6h10v6H3V8zm1 1v4h8v-4H4z"/></svg>
        Panel Admin
      </a>
      <% } %>
      <a href="/dashboard#partidos" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2l4 4-1 1 2 2 1-1 4 4 1-1-4-4 1-1-2-2-1 1L4 1 2 2zm9 9l-1 1 2 2 2-1-1-2-2 0zM5 10l-3 3 1 2 2-1 1-3-1-1z"/></svg>
        Mis Partidos
        <% if (partidosPendientes.length > 0) { %><span class="nav-badge"><%= partidosPendientes.length %></span><% } %>
      </a>
      <a href="/dashboard#historial" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 2a6 6 0 100 12A6 6 0 008 2zm0 1a5 5 0 110 10A5 5 0 018 3zm-1 2v4l3 1.5-.5.9L6 9.5V5h1z"/></svg>
        Historial
      </a>

      <div class="nav-label" style="margin-top:8px">Torneo</div>
      <% if (slugActivo) { %>
        <a href="/penca/<%= slugActivo %>" class="nav-item">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3 1h10v4c0 2.76-2.24 5-5 5S3 7.76 3 5V1zm-2 1v3a3 3 0 003 3v1H3v1h10v-1H9V8a3 3 0 003-3V2H5zm6 9H7v1H5v1h6v-1H9v-1z"/></svg>
          Pencas
        </a>
        <a href="/torneo/<%= slugActivo %>" class="nav-item">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2h4v3H1V2zm0 9h4v3H1v-3zm6-4h4v3H7V7zm4-5h3v12h-3v-1h2V2h-2V1z"/></svg>
          Bracket
        </a>
      <% } else { %>
        <span class="nav-item" style="opacity:.4;cursor:default">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2h4v3H1V2zm0 9h4v3H1v-3zm6-4h4v3H7V7zm4-5h3v12h-3v-1h2V2h-2V1z"/></svg>
          Bracket
        </span>
      <% } %>
      <a href="https://www.aoe2companion.com/statistics/leaderboard" target="_blank" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M6 2h4v12H6V2zm-5 5h4v7H1V7zm10 3h4v4h-4v-4z"/></svg>
        Ranking
      </a>
    </div>

    <!-- Cerrar sesión -->
    <div class="sidebar-footer">
      <form method="POST" action="/auth/logout" style="margin:0">
        <button type="submit" class="signout-btn">Abandonar campo</button>
      </form>
    </div>
  </aside>

  <!-- ── MAIN ── -->
  <main class="main">

    <% if (flash) { %><div class="alert alert-ok"><%= flash %></div><% } %>
    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>

    <!-- ── INVITACIONES RECIBIDAS ── -->
    <% if (invitacionesRecibidas && invitacionesRecibidas.length > 0) { %>
    <div id="invitaciones-recibidas" style="margin-bottom:20px">
      <div class="section-label" style="color:var(--gold)">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" style="margin-right:5px"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 2a5 5 0 110 10A5 5 0 018 3zm-.5 2v4l3.5 2-.7 1.2L6 10V5h1.5z"/></svg>
        Invitaciones pendientes
      </div>
      <% invitacionesRecibidas.forEach(inv => { %>
      <div class="panel" style="margin-bottom:10px;border-color:rgba(232,200,122,0.4)">
        <div style="padding:14px 16px">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <div style="flex:1;min-width:0">
              <div style="font-size:13px;color:var(--text);margin-bottom:4px;word-break:break-word">
                <strong style="color:var(--gold)"><%= inv.invitador_nombre %></strong>
                te invita a formar el equipo
                <strong style="color:var(--celeste)">"<%= inv.nombre_equipo %>"</strong>
              </div>
              <div style="font-size:11px;color:var(--muted)">Torneo: <%= inv.torneo_nombre %></div>
            </div>
            <div style="display:flex;gap:8px;flex-shrink:0;flex-wrap:wrap;width:100%;justify-content:flex-end" id="inv-btns-<%= inv.id %>">
              <button class="btn-submit" style="padding:8px 12px;font-size:11px;flex:1;min-width:70px" onclick="responderInvitacion(<%= inv.id %>, 'aceptar')">
                <i class="fas fa-check" style="margin-right:4px"></i>Aceptar
              </button>
              <button class="btn-action btn-danger" style="padding:8px 12px;font-size:11px;flex:1;min-width:70px" onclick="responderInvitacion(<%= inv.id %>, 'rechazar')">
                <i class="fas fa-times" style="margin-right:4px"></i>Rechazar
              </button>
            </div>
          </div>
          <div id="inv-fb-<%= inv.id %>" style="font-size:12px;margin-top:8px"></div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

    <!-- Sin cuenta vinculada -->
    <% if (!usuarioInterno) { %>
    <div class="reclutamiento">
      <h2>Reclutamiento</h2>
      <p>Tu espada aún no ha sido registrada en nuestros anales.<br>Vincula tu perfil de AoE2 Companion para unirte. Recuerda que tienes que tener partidas rankeadas 1v1 en AoE2 Companion.</p>
      <div class="vincular-form">
        <div>
          <label>Link de AoE2 Companion</label>
          <input id="vincular-url" type="text" class="vincular-input" placeholder="https://www.aoe2companion.com/players/2583713" style="font-size:14px;padding:12px" />
          <div class="vincular-hint" style="margin-top:6px">Entra a aoe2companion.com, busca tu perfil y copia la URL completa.</div>
        </div>
        <div id="vincular-feedback" class="vincular-feedback"></div>
        <button onclick="vincularPerfil()" class="btn-submit" style="padding:12px;font-size:13px">Vincular perfil</button>
      </div>
    </div>

    <% } else { %>

    <!-- Cabecera -->
    <div class="page-header">
      <div>
        <div class="page-title"><%= usuarioInterno.nombre %></div>
        <div class="page-sub" style="color:var(--celeste)">
          <% if (partidosPendientes.length > 0) { %>
            <%= partidosPendientes.length %> batalla<%= partidosPendientes.length > 1 ? 's' : '' %> pendiente<%= partidosPendientes.length > 1 ? 's' : '' %>
          <% } else { %>
            Sin batallas pendientes · Descansa, guerrero
          <% } %>
        </div>
      </div>
    </div>

    <!-- Stat cards -->
    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-label">ELO</div>
        <div class="stat-value highlight"><%= usuarioInterno.elo %></div>
        <% if (usuarioInterno.elomax) { %><div class="stat-sub">Máx. <%= usuarioInterno.elomax %></div><% } %>
      </div>
      <div class="stat-card">
        <div class="stat-label">Victorias</div>
        <div class="stat-value"><%= usuarioInterno.wins %></div>
        <% if (winrate !== null) { %><div class="stat-sub"><%= winrate %>% winrate</div><% } %>
      </div>
      <div class="stat-card">
        <div class="stat-label">Derrotas</div>
        <div class="stat-value"><%= usuarioInterno.losses %></div>
        <div class="stat-sub">
          W/L: <%= usuarioInterno.losses > 0 ? (usuarioInterno.wins / usuarioInterno.losses).toFixed(1) : '—' %>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-label">País</div>
        <div class="stat-value" style="font-size:14px;margin-top:4px"><%= usuarioInterno.pais %></div>
        <div class="stat-sub"><%= usuarioInterno.clan ? 'Clan: ' + usuarioInterno.clan : 'Sin clan' %></div>
      </div>
    </div>

    <!-- Content grid -->
    <div class="dash-grid">

      <!-- Columna izquierda: partidos -->
      <div id="partidos" class="dashboard-battles">
        <div class="section-label">Próximas batallas</div>

        <% if (partidosPendientes.length === 0) { %>
        <div class="empty-dash">No tienes duelos pendientes — descansa, guerrero.</div>
        <% } else { %>
        <% partidosPendientes.forEach(p => { %>
        <div class="match-card">
          <div class="match-card-header">
            <div>
              <% if (p.torneo_nombre) { %>
              <div style="font-size:10px;color:var(--gold);letter-spacing:1px;text-transform:uppercase;margin-bottom:3px;opacity:0.8">
                <% if (p.torneo_slug) { %><a href="/torneo/<%= p.torneo_slug %>" style="color:inherit;text-decoration:none"><%= p.torneo_nombre %></a><% } else { %><%= p.torneo_nombre %><% } %>
              </div>
              <% } %>
              <div class="match-phase"><%= p.fase %></div>
              <% if (p.coordinado) { %>
              <div class="match-schedule">
                <i class="fas fa-clock" style="color:var(--gold);margin-right:3px"></i>
                <%= new Date(p.coordinado).toLocaleDateString('es-AR', {day:'2-digit',month:'2-digit'}) %>
                <%= new Date(p.coordinado).toLocaleTimeString('es-AR', {hour:'2-digit',minute:'2-digit'}) %>
              </div>
              <% } %>
            </div>
            <div class="match-round"><%= p.grupo_nombre || 'Ronda ' + p.ronda %></div>
          </div>

          <div class="match-body">
            <div class="player-name"><%= p.esEquipo ? p.eq1_nombre : p.j1_nombre %></div>
            <div class="vs-badge">VS</div>
            <div class="player-name right"><%= p.esEquipo ? p.eq2_nombre : p.j2_nombre %></div>
          </div>

          <% if (p.elo1 || p.elo2) { %>
          <div style="padding:10px 14px;border-top:0.5px solid var(--brown2);border-bottom:0.5px solid var(--brown2);font-size:12px">
            <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin-bottom:6px">
              <div style="text-align:left;color:var(--celeste)">
                <strong style="color:var(--text)">ELO Inscripción</strong>
                <div style="font-size:11px;color:var(--muted);margin-top:2px"><%= p.elo1 || '—' %></div>
              </div>
              <div style="text-align:center">
                <div style="color:var(--gold);font-size:11px;letter-spacing:0.5px">DIFERENCIA</div>
                <div style="color:var(--text);font-weight:600"><%= p.diferenciaElo %></div>
              </div>
              <div style="text-align:right;color:var(--rosa)">
                <strong style="color:var(--text)">ELO Inscripción</strong>
                <div style="font-size:11px;color:var(--muted);margin-top:2px"><%= p.elo2 || '—' %></div>
              </div>
            </div>
            <% if (p.handicap > 0) { %>
            <div style="text-align:center;padding:6px;background:rgba(232,200,122,0.1);border:0.5px solid rgba(232,200,122,0.2);border-radius:4px;font-size:11px;color:var(--gold)">
              ⚖️ Handicap: <strong><%= p.handicap %>%</strong> para <%= p.favorecido === 'j1' ? (p.esEquipo ? p.eq1_nombre : p.j1_nombre) : (p.esEquipo ? p.eq2_nombre : p.j2_nombre) %>
            </div>
            <% } %>
          </div>
          <% } %>

          <div class="match-actions">
            <div class="match-action" style="padding:0;border-right:0.5px solid var(--brown2)">
              <form class="coordinar-form coordinar-wrap" data-id="<%= p.id %>" style="width:100%">
                <input type="datetime-local" name="fecha_hora"
                  value="<%= p.coordinado ? p.coordinado.replace(' ','T').substring(0,16) : '' %>"
                  style="flex:1;min-width:0" />
                <button type="submit" style="white-space:nowrap;flex-shrink:0;min-width:60px">Agendar</button>
              </form>
            </div>
            <a href="/dashboard/partido/<%= p.id %>" class="match-action primary">
              <i class="fas fa-film"></i>
              <span style="display:none"><%= p.estado === 'finalizado' ? 'Editar REC' : 'Cargar REC' %></span>
              <span>REC</span>
            </a>
          </div>
        </div>
        <% }) %>
        <% } %>

        <!-- Historial -->
        <% if (partidosFinalizados.length > 0) { %>
        <div id="historial" style="margin-top:28px">
          <div class="section-label">Últimos resultados</div>
          <div class="panel">
            <% partidosFinalizados.forEach((p, idx) => {
              const ganoYo = p.gane;
              const rival  = p.rival;
            %>
            <div class="history-item">
              <div>
                <div class="history-players">vs <%= rival %></div>
                <div class="history-phase"><%= p.fase %></div>
              </div>
              <div class="<%= ganoYo ? 'score-win' : 'score-loss' %>">
                <%= p.score1 %> – <%= p.score2 %>
              </div>
              <div class="history-links">
                <% if (p.rec_link) { %>
                  <a href="<%= p.rec_link %>" download class="history-link"><i class="fas fa-download"></i> REC</a>
                <% } %>
                <a href="/dashboard/partido/<%= p.id %>" class="history-link">Editar</a>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>

      <!-- Columna derecha -->
      <div class="dashboard-profile">
        <!-- Torneos activos -->
        <% if (torneosActivos.length > 0) { %>
        <div class="section-label">Torneos activos</div>
        <% torneosActivos.forEach(t => { %>
        <div class="panel" style="margin-bottom:14px">
          <div class="panel-header">
            <a href="/torneo/<%= t.slug %>" class="panel-title" style="color:inherit;text-decoration:none">
              <%= t.nombre %>
            </a>
            <span class="estado-badge estado-<%= t.estado === 'inscripcion' ? 'inscripcion' : 'jugando' %>">
              <%= t.estado === 'inscripcion' ? 'INSCRIPCIONES' : 'EN CURSO' %>
            </span>
          </div>
          <div style="padding:14px 16px">
            <div style="font-size:11px;color:var(--muted);margin-bottom:10px;letter-spacing:0.5px">
              <%= t.tipo %> · <%= t.formato.replace(/_/g,' ') %>
            </div>
            <% if (t.costo_inscripcion > 0) { %>
            <div style="display:flex;align-items:center;gap:6px;padding:7px 10px;margin-bottom:8px;background:rgba(245,158,11,0.07);border:0.5px solid rgba(245,158,11,0.3);border-radius:6px;font-size:11px">
              <span style="color:#f59e0b">💰</span>
              <span style="color:var(--muted)">Inscripción con costo:</span>
              <strong style="color:#f59e0b">$<%= t.costo_inscripcion %></strong>
              <% if (inscripciones[t.id]) { %>
                <% if (inscripciones[t.id].pago) { %>
                  <span style="margin-left:auto;color:#4ade80;font-weight:600">✓ Pagado</span>
                <% } else { %>
                  <span style="margin-left:auto;color:#f87171;font-weight:600">⚠ Pendiente</span>
                <% } %>
              <% } %>
            </div>
            <% } %>
            <% if (t.estado === 'inscripcion') { %>
              <% if (inscripciones[t.id]) { %>
                <div class="inscrito-msg"><i class="fas fa-check" style="margin-right:6px"></i>Inscrito</div>

                <%# Widget de equipo para torneos por equipo %>
                <% if (['2v2','3v3','4v4'].includes(t.tipo)) { %>
                  <% if (equipoStatus[t.id] === 'tiene_equipo') { %>
                    <div style="margin-top:10px;padding:8px 10px;background:rgba(34,197,94,0.08);border:0.5px solid rgba(34,197,94,0.3);border-radius:6px;font-size:12px;color:#4ade80;text-align:center">
                      <i class="fas fa-users" style="margin-right:5px"></i>Equipo formado
                    </div>
                  <% } else { %>
                    <%# Sin equipo: mostrar widget invitar o estado de invitación enviada %>
                    <% if (invitacionEnviada[t.id]) { %>
                      <div style="margin-top:10px;padding:10px;background:rgba(232,200,122,0.07);border:0.5px solid rgba(232,200,122,0.3);border-radius:6px">
                        <div style="font-size:11px;color:var(--gold);margin-bottom:6px;letter-spacing:.5px">INVITACIÓN ENVIADA</div>
                        <div style="font-size:12px;color:var(--text)">
                          Esperando respuesta de <strong><%= invitacionEnviada[t.id].invitado_nombre %></strong>
                        </div>
                        <div style="font-size:11px;color:var(--muted);margin-top:2px">
                          Equipo: "<%= invitacionEnviada[t.id].nombre_equipo %>"
                        </div>
                        <button class="btn-action btn-danger" style="margin-top:8px;padding:4px 12px;font-size:11px"
                          onclick="cancelarInvitacion(<%= invitacionEnviada[t.id].id %>, this)">
                          Cancelar invitación
                        </button>
                      </div>
                    <% } else { %>
                      <div style="margin-top:10px" id="equipo-widget-<%= t.id %>">
                        <div style="font-size:11px;color:var(--gold);margin-bottom:8px;letter-spacing:.5px">CONFIGURAR EQUIPO</div>
                        <div style="margin-bottom:8px">
                          <input type="text" id="nombre-equipo-<%= t.id %>" placeholder="Nombre del equipo"
                            style="width:100%;padding:10px;background:var(--bg3);border:0.5px solid var(--brown);border-radius:6px;color:var(--text);font-size:14px;box-sizing:border-box" />
                        </div>
                        <div style="margin-bottom:8px">
                          <input type="text" id="buscar-jugador-<%= t.id %>" placeholder="Buscar compañero..."
                            oninput="filtrarJugadores('<%= t.id %>')"
                            style="width:100%;padding:10px;background:var(--bg3);border:0.5px solid var(--brown);border-radius:6px;color:var(--text);font-size:14px;box-sizing:border-box" />
                          <select id="select-jugador-<%= t.id %>" size="4"
                            style="width:100%;margin-top:4px;padding:8px;background:var(--bg3);border:0.5px solid var(--brown);border-radius:6px;color:var(--text);font-size:12px;display:none;line-height:1.8">
                            <% todosLosJugadores.filter(j => j.discordId !== user.id).forEach(j => { %>
                            <option value="<%= j.discordId %>" data-nombre="<%= j.nombre.toLowerCase() %>">
                              <%= j.nombre %> (ELO <%= j.elo %><%= j.clan ? ' · ' + j.clan : '' %>)
                            </option>
                            <% }) %>
                          </select>
                        </div>
                        <div id="selected-jugador-<%= t.id %>" style="font-size:11px;color:var(--celeste);min-height:16px;margin-bottom:6px"></div>
                        <button class="btn-submit" style="width:100%;padding:10px;font-size:12px"
                          onclick="enviarInvitacion('<%= t.id %>')">
                          <i class="fas fa-paper-plane" style="margin-right:5px"></i>Invitar compañero
                        </button>
                        <div id="inv-send-fb-<%= t.id %>" style="font-size:12px;margin-top:6px"></div>
                      </div>
                    <% } %>
                  <% } %>
                <% } %>
              <% } else { %>
                <button class="btn-inscribir" data-torneo="<%= t.id %>" data-fb="fb-<%= t.id %>">
                  <i class="fas fa-plus"></i> Inscribirse
                </button>
                <div id="fb-<%= t.id %>" class="vincular-feedback" style="margin-top:8px"></div>
              <% } %>
            <% } else { %>
              <div style="font-size:11px;color:var(--celeste);text-align:center">Torneo en curso</div>
            <% } %>
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
              <a href="/torneo/<%= t.slug %>" class="btn-submit" style="flex:1;padding:7px 10px;font-size:12px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none">
                <i class="fas fa-sitemap" style="margin-right:6px"></i>Ver grupos y partidos
              </a>
              <a href="/penca/<%= t.slug %>" class="btn-action" style="flex:1;display:inline-flex;align-items:center;justify-content:center;">
                <i class="fas fa-futbol" style="margin-right:6px"></i>Penca
              </a>
            </div>
          </div>
        </div>
        <% }) %>
        <% } %>

        <!-- Perfil AOE2 -->
        <div class="section-label" style="margin-top:<%= torneoActivo ? '8px' : '0' %>">Perfil AOE2</div>
        <div class="panel">
          <% [
            ['Nombre', usuarioInterno.nombre],
            ['ELO', usuarioInterno.elo],
            ['Rank', usuarioInterno.rank ? '#' + usuarioInterno.rank : '—'],
            ['País', usuarioInterno.pais],
            ['Clan', usuarioInterno.clan || '—'],
          ].forEach(([label, val]) => { %>
          <div class="profile-row">
            <span class="profile-label"><%= label %></span>
            <span class="profile-value"><%= val %></span>
          </div>
          <% }) %>
        </div>
      </div>

    </div><!-- /dash-grid -->
    <% } %><!-- /usuarioInterno -->

  </main>
</div><!-- /app -->

<script>
/* ── VINCULAR PERFIL ── */
async function vincularPerfil() {
  const url = document.getElementById('vincular-url')?.value?.trim();
  const fb = document.getElementById('vincular-feedback');
  if (!url) { showFeedback(fb, 'Ingresa el link de tu perfil.', false); return; }
  try {
    const r = await fetch('/api/usuarios/vincular', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url })
    });
    const d = await r.json();
    if (d.success) { showFeedback(fb, '¡Perfil vinculado! Recargando...', true); setTimeout(() => location.reload(), 1200); }
    else showFeedback(fb, d.error || 'Error al vincular.', false);
  } catch { showFeedback(fb, 'Error de conexión.', false); }
}

/* ── COORDINAR ── */
document.querySelectorAll('.coordinar-form').forEach(form => {
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const partidoId = form.dataset.id;
    const fechaLocal = form.querySelector('[name=fecha_hora]').value;
    if (!fechaLocal) return;
    try {
      // Convertir datetime-local a UTC (igual que en partido.ejs)
      const [d, t] = fechaLocal.split('T');
      const [a, m, da] = d.split('-');
      const [h, min] = t.split(':');
      const fechaEnZonaLocal = new Date(a, m - 1, da, h, min, 0);
      const fechaISO = fechaEnZonaLocal.toISOString();

      const r = await fetch('/api/partidos/coordinar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ partidoId, fecha_hora: fechaISO })
      });
      const d = await r.json();
      if (d.success) location.reload();
      else alert(d.error || 'Error al coordinar.');
    } catch { alert('Error de conexión.'); }
  });
});

/* ── INSCRIBIR ── */
document.querySelectorAll('.btn-inscribir').forEach(btn => {
  btn.addEventListener('click', async () => {
    const torneoId = btn.dataset.torneo;
    const fb = document.getElementById(btn.dataset.fb);
    btn.disabled = true;
    try {
      const r = await fetch('/api/torneos/inscribir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ torneoId })
      });
      const d = await r.json();
      if (d.success) { showFeedback(fb, '¡Inscripto! Recargando...', true); setTimeout(() => location.reload(), 1000); }
      else { showFeedback(fb, d.error || 'Error al inscribirse.', false); btn.disabled = false; }
    } catch { showFeedback(fb, 'Error de conexión.', false); btn.disabled = false; }
  });
});

function showFeedback(el, msg, ok) {
  el.textContent = msg;
  el.className = 'vincular-feedback ' + (ok ? 'ok' : 'err');
}

/* ── FILTRAR JUGADORES EN COMBO ── */
function filtrarJugadores(torneoId) {
  const q = document.getElementById('buscar-jugador-' + torneoId)?.value?.toLowerCase() || '';
  const sel = document.getElementById('select-jugador-' + torneoId);
  if (!sel) return;
  sel.style.display = q.length >= 1 ? 'block' : 'none';
  Array.from(sel.options).forEach(opt => {
    opt.style.display = opt.dataset.nombre.includes(q) ? '' : 'none';
  });
  const vis = Array.from(sel.options).filter(o => o.style.display !== 'none');
  if (vis.length === 1) {
    sel.value = vis[0].value;
    document.getElementById('selected-jugador-' + torneoId).textContent = 'Seleccionado: ' + vis[0].text;
  }
  sel.onchange = () => {
    const opt = sel.options[sel.selectedIndex];
    document.getElementById('selected-jugador-' + torneoId).textContent = 'Seleccionado: ' + opt.text;
  };
}

/* ── ENVIAR INVITACIÓN ── */
async function enviarInvitacion(torneoId) {
  const nombre = document.getElementById('nombre-equipo-' + torneoId)?.value?.trim();
  const sel = document.getElementById('select-jugador-' + torneoId);
  const invitadoId = sel?.value;
  const fb = document.getElementById('inv-send-fb-' + torneoId);

  if (!nombre) { if(fb){fb.textContent='Ingresá el nombre del equipo.';fb.style.color='#f87171';} return; }
  if (!invitadoId) { if(fb){fb.textContent='Seleccioná un compañero.';fb.style.color='#f87171';} return; }

  try {
    const r = await fetch('/api/torneos/invitar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ torneoId, invitadoId, nombreEquipo: nombre })
    });
    const d = await r.json();
    if (d.success) {
      if(fb){fb.textContent='¡Invitación enviada! Recargando...';fb.style.color='#4ade80';}
      setTimeout(() => location.reload(), 1200);
    } else {
      if(fb){fb.textContent = d.error || 'Error al enviar.';fb.style.color='#f87171';}
    }
  } catch {
    if(fb){fb.textContent='Error de conexión.';fb.style.color='#f87171';}
  }
}

/* ── CANCELAR INVITACIÓN ENVIADA ── */
async function cancelarInvitacion(invitacionId, btn) {
  if (!confirm('¿Cancelar la invitación?')) return;
  btn.disabled = true;
  try {
    const r = await fetch('/api/torneos/cancelar-invitacion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ invitacionId })
    });
    const d = await r.json();
    if (d.success) location.reload();
    else { alert(d.error || 'Error.'); btn.disabled = false; }
  } catch { alert('Error de conexión.'); btn.disabled = false; }
}

/* ── RESPONDER INVITACIÓN RECIBIDA ── */
async function responderInvitacion(invitacionId, accion) {
  const btns = document.getElementById('inv-btns-' + invitacionId);
  const fb   = document.getElementById('inv-fb-'   + invitacionId);
  if (btns) btns.style.pointerEvents = 'none';

  try {
    const r = await fetch('/api/torneos/responder-invitacion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ invitacionId, accion })
    });
    const d = await r.json();
    if (d.success) {
      if(fb){fb.textContent = accion === 'aceptar' ? '¡Equipo formado! Recargando...' : 'Invitación rechazada.';fb.style.color=accion==='aceptar'?'#4ade80':'#f87171';}
      setTimeout(() => location.reload(), 1000);
    } else {
      if(fb){fb.textContent = d.error || 'Error.';fb.style.color='#f87171';}
      if (btns) btns.style.pointerEvents = '';
    }
  } catch {
    if(fb){fb.textContent='Error de conexión.';fb.style.color='#f87171';}
    if (btns) btns.style.pointerEvents = '';
  }
}

/* Sidebar Hamburger Menu */
const hamburger = document.getElementById('sidebar-hamburger');
const sidebar = document.getElementById('dashboard-sidebar');
if (hamburger && sidebar) {
  hamburger.addEventListener('click', () => {
    sidebar.classList.toggle('mobile-open');
    hamburger.classList.toggle('active');
  });
  // Close sidebar when clicking outside
  document.addEventListener('click', (e) => {
    if (!sidebar.contains(e.target) && !hamburger.contains(e.target)) {
      sidebar.classList.remove('mobile-open');
      hamburger.classList.remove('active');
    }
  });
  // Close sidebar when clicking a nav link
  sidebar.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      sidebar.classList.remove('mobile-open');
      hamburger.classList.remove('active');
    });
  });
}
</script>
</body>
</html>
