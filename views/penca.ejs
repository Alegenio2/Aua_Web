<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Penca: <%= torneo.nombre %> — AUA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cinzel+Decorative:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="/img/favicon-32x32.png" type="image/png" />
  <style>
    /* ── Penca específico ── */
    .penca-wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px 60px; position: relative; z-index: 1; }

    .penca-hero { text-align: center; padding: 40px 24px 30px; position: relative; }
    .penca-hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 80% at 50% 0%, rgba(232,200,122,0.07) 0%, transparent 70%);
      pointer-events: none;
    }
    .penca-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(22px, 4vw, 36px);
      color: var(--gold); letter-spacing: 2px; margin-bottom: 6px;
    }
    .penca-sub { font-size: 12px; color: var(--muted); letter-spacing: 3px; text-transform: uppercase; }
    .penca-status {
      display: inline-flex; align-items: center; gap: 8px;
      margin-top: 14px; padding: 6px 16px; border-radius: 20px; font-size: 11px; letter-spacing: 1px;
    }
    .penca-status.open { background: rgba(168,200,96,0.12); border: 0.5px solid rgba(168,200,96,0.3); color: var(--win); }
    .penca-status.closed { background: rgba(200,60,60,0.1); border: 0.5px solid rgba(200,60,60,0.25); color: #cc5555; }

    .penca-grid { display: grid; grid-template-columns: 1fr 300px; gap: 24px; align-items: start; }

    /* Campeón */
    .campeon-box {
      background: var(--bg2); border: 0.5px solid rgba(232,200,122,0.4);
      border-radius: 10px; overflow: hidden; margin-bottom: 20px;
    }
    .campeon-box .box-header { background: linear-gradient(135deg, rgba(232,200,122,0.08), var(--bg3)); }
    .campeon-box select {
      width: 100%; padding: 12px 14px; background: var(--bg3);
      border: 0.5px solid var(--brown); border-radius: 7px;
      color: var(--text); font-size: 13px; outline: none; cursor: pointer;
      transition: border-color 0.18s;
    }
    .campeon-box select:focus { border-color: var(--gold2); }
    .campeon-box select:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Ronda label */
    .ronda-label {
      font-family: 'Cinzel', serif; font-size: 10px;
      color: var(--dim); letter-spacing: 2px; text-transform: uppercase;
      margin: 20px 0 10px; display: flex; align-items: center; gap: 10px;
    }
    .ronda-label::after {
      content: ''; flex: 1; height: 0.5px;
      background: linear-gradient(to right, rgba(232,200,122,0.15), transparent);
    }

    /* Tarjeta partido penca */
    .penca-card {
      background: var(--bg2); border: 0.5px solid var(--brown);
      border-radius: 10px; overflow: hidden; margin-bottom: 10px;
      transition: border-color 0.18s;
    }
    .penca-card:hover { border-color: rgba(232,200,122,0.25); }
    .penca-card.finalizado { opacity: 0.6; }

    .penca-card-body {
      display: grid; grid-template-columns: 1fr auto 1fr;
      align-items: center; gap: 12px; padding: 16px;
    }
    .penca-player { font-size: 13px; font-weight: 500; color: var(--text); }
    .penca-player.right { text-align: right; }

    .penca-inputs { display: flex; align-items: center; gap: 8px; }
    .penca-input {
      width: 46px; padding: 8px 6px; background: var(--bg3);
      border: 0.5px solid var(--brown); border-radius: 7px;
      color: var(--text); font-size: 15px; font-weight: 500;
      text-align: center; outline: none; transition: border-color 0.18s;
    }
    .penca-input:focus { border-color: var(--gold2); }
    .penca-input:disabled { opacity: 0.5; cursor: not-allowed; }
    .penca-sep { font-family: 'Cinzel', serif; color: var(--dim); font-size: 14px; }

    .penca-card-footer {
      padding: 6px 16px; background: var(--bg3);
      border-top: 0.5px solid var(--brown2);
      display: flex; align-items: center; justify-content: space-between;
    }
    .penca-card-fase { font-size: 9px; color: var(--dim); letter-spacing: 1px; text-transform: uppercase; }
    .penca-result-real { font-size: 11px; color: var(--win); font-weight: 500; }

    /* Submit */
    .penca-submit {
      width: 100%; padding: 14px; margin-top: 10px;
      background: var(--gold); color: var(--bg0);
      border: none; border-radius: 8px; cursor: pointer;
      font-family: 'Cinzel', serif; font-size: 13px;
      font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
      transition: all 0.18s;
    }
    .penca-submit:hover { background: var(--gold-light); transform: translateY(-1px); }

    /* Ranking lateral */
    .ranking-panel { background: var(--bg2); border: 0.5px solid var(--brown); border-radius: 10px; overflow: hidden; }
    .ranking-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 16px; border-bottom: 0.5px solid var(--brown2);
      transition: background 0.15s;
    }
    .ranking-row:last-child { border-bottom: none; }
    .ranking-row:hover { background: rgba(255,255,255,0.01); }
    .rank-pos { width: 22px; font-size: 11px; color: var(--dim); text-align: center; flex-shrink: 0; font-family: 'Cinzel', serif; }
    .rank-pos.top { color: var(--gold); font-size: 14px; }
    .rank-name { flex: 1; font-size: 12px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rank-pts { font-size: 16px; font-weight: 600; color: var(--gold); flex-shrink: 0; }
    .rank-sub { font-size: 10px; color: var(--dim); }
    .rank-empty { padding: 24px; text-align: center; font-size: 12px; color: var(--dim); }

    /* Reglas */
    .reglas-box { background: var(--bg2); border: 0.5px solid var(--brown); border-radius: 10px; overflow: hidden; margin-top: 16px; }
    .regla-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 0.5px solid var(--brown2); font-size: 12px; color: var(--muted); }
    .regla-item:last-child { border-bottom: none; }
    .regla-pts { font-size: 16px; font-weight: 700; color: var(--gold); min-width: 28px; text-align: center; }

    @media (max-width: 768px) {
      .penca-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<header>
  <a class="header-logo" href="/">
    <span class="logo-icon">⚔</span>
    <span class="logo-text">AUA</span>
  </a>
  <nav>
    <a href="/">Inicio</a>
    <a href="/eventos">Eventos</a>
    <a href="/torneos">Salón de la Fama</a>
    <a class="nav-stats active" href="/penca/<%= torneo.slug %>">🏆 Penca</a>
  </nav>
  <div class="header-actions">
    <% if (user) { %>
      <a href="/dashboard" class="nav-user" title="Dashboard">
        <% if (user.image) { %><img src="<%= user.image %>" alt="avatar" class="nav-avatar" /><% } %>
        <span><%= user.name %></span>
      </a>
      <form method="POST" action="/auth/logout" style="display:inline;margin:0">
        <button type="submit" class="nav-logout-btn" title="Cerrar sesión">✕</button>
      </form>
    <% } else { %>
      <a href="/auth/discord" class="nav-discord-btn"><i class="fab fa-discord"></i>Ingresar</a>
    <% } %>
  </div>
</header>

<div class="penca-hero fade-up">
  <div class="penca-title">🏆 Penca</div>
  <div class="penca-sub"><%= torneo.nombre %></div>
  <div class="penca-status <%= cerrada ? 'closed' : 'open' %>">
    <% if (cerrada) { %>
      <i class="fas fa-lock"></i> Apuestas cerradas — el torneo ya comenzó
    <% } else { %>
      <i class="fas fa-unlock"></i> Apuestas abiertas — predice antes de que empiece la primera partida
    <% } %>
  </div>
</div>

<div class="penca-wrap">

  <% if (flash) { %>
  <div style="padding:10px 16px;border-radius:8px;font-size:12px;margin-bottom:18px;background:rgba(168,200,96,0.1);border:0.5px solid rgba(168,200,96,0.3);color:var(--win)">
    <i class="fas fa-check" style="margin-right:6px"></i><%= flash %>
  </div>
  <% } %>
  <% if (error) { %>
  <div style="padding:10px 16px;border-radius:8px;font-size:12px;margin-bottom:18px;background:rgba(200,60,60,0.1);border:0.5px solid rgba(200,60,60,0.3);color:#cc5555">
    <i class="fas fa-exclamation-triangle" style="margin-right:6px"></i><%= error %>
  </div>
  <% } %>

  <div class="penca-grid">

    <!-- Columna izquierda: predicciones -->
    <div>
      <form method="POST" action="/penca/votar">
        <input type="hidden" name="torneo_id" value="<%= torneo.id %>" />

        <!-- Campeón -->
        <% if (inscriptos.length > 0) { %>
        <div class="campeon-box">
          <div class="box-header"><i class="fas fa-crown"></i> ¿Quién será el Campeón?</div>
          <div style="padding:16px">
            <select name="campeon_id" <%= cerrada ? 'disabled' : '' %>>
              <option value="">Selecciona tu favorito...</option>
              <% inscriptos.forEach(j => { %>
                <option value="<%= j.discordId %>" <%= miVotoCampeon?.campeon_id === j.discordId ? 'selected' : '' %>>
                  <%= j.nombre %>
                </option>
              <% }) %>
            </select>
            <p style="font-size:11px;color:var(--dim);margin-top:8px">Acertar al campeón otorga puntos extra al final.</p>
          </div>
        </div>
        <% } %>

        <!-- Partidos por ronda -->
        <%
          const rondas = [...new Set(partidos.map(p => p.ronda))];
        %>
        <% rondas.forEach(ronda => { %>
          <div class="ronda-label">Ronda <%= ronda %></div>
          <% partidos.filter(p => p.ronda === ronda).forEach(p => {
            const voto = votosMap[p.id] || { s1: 0, s2: 0 };
            const esFinalizado = p.estado === 'finalizado';
          %>
          <div class="penca-card <%= esFinalizado ? 'finalizado' : '' %>">
            <div class="penca-card-body">
              <div class="penca-player"><%= p.n1 %></div>
              <div class="penca-inputs">
                <input type="number" class="penca-input"
                  name="score1_<%= p.id %>"
                  min="0" max="9"
                  value="<%= voto.s1 %>"
                  <%= cerrada ? 'disabled' : '' %> />
                <span class="penca-sep">-</span>
                <input type="number" class="penca-input"
                  name="score2_<%= p.id %>"
                  min="0" max="9"
                  value="<%= voto.s2 %>"
                  <%= cerrada ? 'disabled' : '' %> />
              </div>
              <div class="penca-player right"><%= p.n2 %></div>
            </div>
            <% if (esFinalizado) { %>
            <div class="penca-card-footer">
              <span class="penca-card-fase"><%= p.fase %> · Ronda <%= p.ronda %></span>
              <span class="penca-result-real">Real: <%= p.score1 %> – <%= p.score2 %></span>
            </div>
            <% } else { %>
            <div class="penca-card-footer">
              <span class="penca-card-fase"><%= p.fase %></span>
              <span style="font-size:9px;color:var(--dim)">Pendiente</span>
            </div>
            <% } %>
          </div>
          <% }) %>
        <% }) %>

        <% if (partidos.length === 0) { %>
        <div style="text-align:center;padding:40px;color:var(--dim);font-size:13px">
          Aún no hay partidos generados para este torneo.
        </div>
        <% } %>

        <% if (!cerrada && partidos.length > 0) { %>
        <button type="submit" class="penca-submit">
          <i class="fas fa-save" style="margin-right:8px"></i>Guardar predicciones
        </button>
        <% } %>

      </form>
    </div>

    <!-- Columna derecha: ranking + reglas -->
    <div>
      <!-- Ranking -->
      <div class="section-header" style="margin-bottom:16px">
        <div class="section-icon">🏅</div>
        <div>
          <div class="section-title">Clasificación</div>
          <div class="section-sub">Por puntos totales</div>
        </div>
        <div class="section-line"></div>
      </div>

      <div class="ranking-panel">
        <% if (ranking.length === 0) { %>
          <div class="rank-empty">Aún no hay predicciones registradas.</div>
        <% } else { %>
          <% ranking.forEach((u, i) => { %>
          <div class="ranking-row">
            <div class="rank-pos <%= i < 3 ? 'top' : '' %>">
              <%= i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : i + 1 %>
            </div>
            <div>
              <div class="rank-name"><%= u.nombre %></div>
              <div class="rank-sub"><%= u.plenos %> plenos · <%= u.total_apuestas %> apuestas</div>
            </div>
            <div class="rank-pts"><%= u.total_puntos %></div>
          </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Reglas -->
      <div class="reglas-box" style="margin-top:16px">
        <div class="box-header"><i class="fas fa-scroll"></i> Sistema de Puntos</div>
        <div class="regla-item"><span class="regla-pts">3</span> Resultado exacto</div>
        <div class="regla-item"><span class="regla-pts">1</span> Ganador correcto</div>
        <div class="regla-item"><span class="regla-pts">0</span> Sin acierto</div>
        <div style="padding:10px 16px;font-size:11px;color:var(--dim)">Las predicciones cierran cuando inicia la primera partida.</div>
      </div>
    </div>

  </div>
</div>

<footer>
  <div class="footer-logo">AUA</div>
  <div class="footer-text">Asociación Uruguaya de Age of Empires II</div>
  <div class="footer-links">
    <a href="https://www.twitch.tv/jabsuy" target="_blank" title="Twitch"><i class="fab fa-twitch"></i></a>
    <a href="https://www.youtube.com/@jabsuy" target="_blank" title="YouTube"><i class="fab fa-youtube"></i></a>
    <a href="https://discord.gg/3xeSRaQxDE" target="_blank" title="Discord"><i class="fab fa-discord"></i></a>
  </div>
</footer>

</body>
</html>
